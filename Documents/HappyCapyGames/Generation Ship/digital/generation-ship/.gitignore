# Godot 4+ specific ignores
.godot/
/android/*
# ...except our own hand-written Android plugin customizations, which
# "Install Android Build Template" can't regenerate (everything else under
# /android/ — the Gradle project, cached dependencies, and a full copy of
# the project's own assets — genuinely is regenerable, hence ignored).
!/android/build/
/android/build/*
!/android/build/gradle.properties
# CameraX for Scan Tableau's own camera screen (ScanCameraActivity) — re-add after
# reinstalling the build template
!/android/build/build.gradle
!/android/build/src/
/android/build/src/*
!/android/build/src/main/
/android/build/src/main/*
!/android/build/src/main/AndroidManifest.xml
!/android/build/src/main/java/
!/android/build/src/main/res/
/android/build/src/main/res/*
!/android/build/src/main/res/xml/

# Build outputs
GS.exe
GS.pck

# Platform export binaries
/androidarm64/
/linux32/
/linux64/
/linuxarm64/
/osx/
/win64/
/redistributable_bin/

# GodotSteam plugin platform binaries (download from godotsteam.com separately)
/addons/godotsteam/androidarm64/
/addons/godotsteam/linux32/
/addons/godotsteam/linux64/
/addons/godotsteam/linuxarm64/
/addons/godotsteam/osx/
/addons/godotsteam/win32/
/addons/godotsteam/win64/
libgodotsteam.windows.template_release.x86_64.dll

# Card art and frames — too large for plain git (card images served from S3 at runtime)
assets/art/
assets/frames/

# Runtime HTTP card image cache
assets/cards/
/Build/

# Steam upload bundle — too large for plain git, built locally as needed
/GS.zip

# steamcmd's own scratch/log output from steam_build/upload_demo.ps1
/SteamBuildOutput/

# gde_gozen leaves stale lock-file remnants (~<hash>.TMP) next to the DLL
# after a crashed/locked reimport — transient, safe to ignore
addons/gde_gozen/bin/*.TMP
